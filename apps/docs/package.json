{
  "name": "relvista-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "sync": "node scripts/sync-assets.mjs",
    "prestart": "node scripts/sync-assets.mjs",
    "start": "docusaurus start",
    "build": "node scripts/sync-assets.mjs && docusaurus build && node scripts/copy-editor.mjs",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "serve:site": "node scripts/serve-site.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/remark-plugin-npm2yarn": "3.10.2",
    "@mdx-js/react": "^3.1.1",
    "@relvista/core": "workspace:*",
    "@relvista/docusaurus-theme": "workspace:*",
    "@relvista/renderer": "workspace:*",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/theme-classic": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@playwright/test": "1.65.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "relvista-editor": "workspace:*",
    "typescript": "~5.9.3"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
