// Adversarial round-trip fixture (e2e/adversarial.spec.ts): every DBML feature, written the way
// dbdiagram.io exports look. Must compile with no diagnostics.

// Use DBML to define your database structure
// Docs: https://dbml.dbdiagram.io/docs

Project "Acme Ops" {
  database_type: 'PostgreSQL'
  Note: '''
    # Acme operations
    Hand-written in the style of a dbdiagram.io export — **do not** edit by hand.
    * multi-line notes
    * `inline code`
  '''
}

Enum "public"."order_status" {
  "created" [note: 'Waiting to be processed']
  "running"
  "done"
  "failure"
  "on hold 🚧"
}

Enum ops.priority {
  low
  medium
  high
}

TablePartial base_template [headercolor: #24BAB1] {
  id int [pk, increment]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp
  indexes {
    created_at [name: 'idx_created']
  }
}

TablePartial soft_delete {
  deleted_at timestamp [null]
}

Table "public"."users" as U [headercolor: #3498DB, note: 'Registered users'] {
  ~base_template
  ~soft_delete
  "full name" varchar(255) [not null, note: 'Display name']
  email varchar [unique, not null]
  date_of_birth date
  country_code char(2) [default: 'US']
  score "double precision" [default: 0.5, check: `score >= 0`]
  is_admin boolean [default: false]
  status order_status [default: 'created']
  Note {
    '''
    Users of the platform.
    Multiple lines.
    '''
  }
}

Table ops.tickets {
  id bigint [pk]
  user_id int [ref: > U.id, not null]
  assignee_id int [ref: - U.id]
  priority ops.priority [default: 'medium']
  title varchar(140) [not null]
  body text
  amount "numeric(10, 2)" [default: 12.50]
  created_at timestamptz [default: `now()`]

  indexes {
    (user_id, created_at) [name: 'tickets_user_created', unique]
    title [type: hash]
    `lower(title)` [name: 'tickets_title_lower']
    (`date(created_at)`, priority) [note: 'expression + column']
    id [pk]
  }

  checks {
    `amount >= 0` [name: 'amount_non_negative']
  }
}

Table merchants {
  id int
  country_code char(2)
  merchant_name varchar

  indexes {
    (id, country_code) [pk]
  }
}

Table orders [headercolor: #990D0D] {
  id int [pk]
  user_id int [not null]
  merchant_id int
  country_code char(2)
  status "public"."order_status"
  created_at varchar [note: 'When order created']
}

Table order_items {
  order_id int [not null]
  product_id int
  quantity int [default: 1]
}

Table products {
  id int [pk]
  name varchar
  merchant_id int [not null]
  price int
  status varchar
  created_at datetime [default: `now()`]
}

Table categories {
  id int [pk]
  parent_id int [ref: > categories.id]
  name varchar
}

Table product_tags {
  id int [pk]
  name varchar
}

Ref fk_orders_user: orders.user_id > U.id [delete: cascade, update: no action]
Ref: products.merchant_id > merchants.id [delete: restrict]
Ref: orders.(merchant_id, country_code) > merchants.(id, country_code)
Ref: order_items.product_id > products.id [color: #E74C3C]
Ref: products.id <> product_tags.id
Ref: orders.id - order_items.order_id [update: set null]

Ref {
  products.id < categories.id [delete: set default]
}

TableGroup commerce [color: #345, note: 'Commerce tables'] {
  orders
  order_items
  products
  merchants
}

TableGroup "people & ops" {
  U
  ops.tickets
  Note: 'Who does what'
}

Note sticky_1 [color: #F4D03F] {
  '''
  Sticky note
  with several lines
  '''
}

Note "sticky two" {
  'Plain note'
}

DiagramView "Commerce only" {
  Tables { orders, order_items, products, merchants }
  Notes { sticky_1 }
}

DiagramView everything {
  Tables { * }
  TableGroups { * }
  Notes { * }
}

records products(id, name, merchant_id, price, status, created_at) {
  1, 'Widget', 1, 999, 'active', '2026-01-01 10:00:00'
  2, 'Gadget \'pro\'', 1, -5, null, `now()`
  3, "Thing", 2, 1.5e1, '', '2026-02-03T04:05:06+02:00'
}
