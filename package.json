{
  "name": "relvista-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:examples": "node scripts/validate-examples.mjs",
    "changeset": "changeset",
    "docs:build": "pnpm --filter relvista-docs... build",
    "docs:start": "pnpm --filter \"relvista-docs^...\" build && pnpm --filter relvista-docs start",
    "test:e2e": "pnpm --filter relvista-docs test:e2e"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9",
    "@types/node": "^24",
    "eslint": "^9",
    "globals": "^17.14.0",
    "prettier": "^3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
