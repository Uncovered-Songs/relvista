{
  "name": "@relvista/core",
  "version": "0.0.0",
  "description": "DBML parsing, diagram model, layout file and auto-layout for relvista",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./layout.schema.json": "./layout.schema.json"
  },
  "files": ["dist", "layout.schema.json"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dbml/parse": "12.1.0"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
