{
  "name": "@relvista/docusaurus-plugin",
  "version": "0.0.0",
  "description": "Docusaurus plugin that adds interactive ER diagrams for DBML code fences and .dbml files, keeping your site's own styling",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "client.d.ts"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "docusaurus",
    "docusaurus-plugin",
    "dbml",
    "erd",
    "er-diagram",
    "database"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@relvista/core": "workspace:*",
    "@relvista/renderer": "workspace:*",
    "elkjs": "0.12.1",
    "@babel/core": "^7.29.0"
  },
  "peerDependencies": {
    "@docusaurus/core": "^3.6",
    "@docusaurus/utils-validation": "^3.6",
    "react": ">=18",
    "react-dom": ">=18",
    "prism-react-renderer": "^2"
  },
  "devDependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/theme-classic": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@docusaurus/utils-validation": "3.10.2",
    "@testing-library/react": "^16",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^27",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4",
    "prism-react-renderer": "^2.4.1",
    "@types/node": "^24",
    "@types/babel__core": "^7.20.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Uncovered-Songs/relvista.git",
    "directory": "packages/docusaurus-plugin"
  },
  "homepage": "https://uncovered-songs.github.io/relvista/"
}
